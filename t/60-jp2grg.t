use v5.36;
use utf8;
use Test::More;
use Grongigo::Jp2Grg qw(convert);

my @cases = (
    ['あいうえお', 'ガギグゲゴ'], ['かきくけこ', 'バビブベボ'], ['さしすせそ', 'ガギグゲゴ'],
    ['たちつてと', 'ダヂヅデド'], ['なにぬねの', 'バビブベボ'], ['はひふへほ', 'ザジズゼゾ'],
    ['まみむめも', 'ラリルレロ'], ['やゆよ', 'ジャジュジョ'], ['らりるれろ', 'サシスセソ'],
    ['わをん', 'パゾン'], ['がぎぐげご', 'ガギグゲゴ'], ['ざじずぜぞ', 'ザジズゼゾ'],
    ['だぢづでど', 'ザジズゼゾ'], ['ばびぶべぼ', 'ダヂヅデド'], ['ぱぴぷぺぽ', 'マミムメモ'],
    ['アイウエオ', 'ガギグゲゴ'], ['カキクケコ', 'バビブベボ'], ['ガギグゲゴ', 'ガギグゲゴ'],
    ['バビブベボ', 'ダヂヅデド'], ['ぁぃぅぇぉゃゅょっ', 'ァィゥェォャュョッ'],
    ['おはよう', 'ゴザジョグ'], ['これはペンです', 'ボセザメンゼグ'], ['あ1い2う', 'ガ1ギ2グ'],
    ['あい うえ', 'ガギ グゲ'], ['', ''], ['123ABC', '123ABC'], ['こんにちは', 'ボンビヂザ'],
    ['リントはクウガとたたかう', 'リントザクウガドダダバグ'], ['グロンギがゲゲルをする', 'グロンギガゲゲルゾグス'],
    ['クウガ リント ゲゲル グロンギ グセパ バグンダダ ゲリザギバスゲゲル ザギバスゲゲル',
     'クウガ リント ゲゲル グロンギ グセパ バグンダダ ゲリザギバスゲゲル ザギバスゲゲル'],
    ['ァィゥェォャュョッー漢字。', 'ァィゥェォャュョッー漢字。'],
    ["こんにちは\nクウガ\t!", "ボンビヂザ\nクウガ\t!"],
);
for my $i (0 .. $#cases) {
    is convert($cases[$i][0]), $cases[$i][1], 'Japanese conversion case ' . ($i + 1);
}
done_testing;
